{
 "chapters": [
  {
   "n": 1,
   "sa": "अर्जुनविषादयोगः",
   "en": "Arjuna's Despair",
   "hi": "अर्जुनविषादयोग",
   "about": "On the battlefield of Kurukshetra, Arjuna sees his own family in the opposing army and collapses in grief, refusing to fight."
  },
  {
   "n": 2,
   "sa": "साङ्ख्ययोगः",
   "en": "The Yoga of Knowledge",
   "hi": "सांख्ययोग",
   "about": "Krishna begins his teaching: the self is eternal, duty must be done with an even mind, and the person of steady wisdom is described."
  },
  {
   "n": 3,
   "sa": "कर्मयोगः",
   "en": "The Yoga of Action",
   "hi": "कर्मयोग",
   "about": "Why action is unavoidable, and how selfless work done as an offering frees rather than binds."
  },
  {
   "n": 4,
   "sa": "ज्ञानकर्मसंन्यासयोगः",
   "en": "Knowledge, Action and Renunciation",
   "hi": "ज्ञानकर्मसंन्यासयोग",
   "about": "Krishna reveals his divine births, and explains how knowledge burns away the bondage of action."
  },
  {
   "n": 5,
   "sa": "कर्मसंन्यासयोगः",
   "en": "Renunciation of Action",
   "hi": "कर्मसंन्यासयोग",
   "about": "Renouncing action and acting without attachment lead to the same goal; the inner peace of the wise."
  },
  {
   "n": 6,
   "sa": "आत्मसंयमयोगः",
   "en": "Self-Control and Meditation",
   "hi": "आत्मसंयमयोग",
   "about": "The practice of meditation, mastering the restless mind, and the balanced life of the yogi."
  },
  {
   "n": 7,
   "sa": "ज्ञानविज्ञानयोगः",
   "en": "Knowledge and Realisation",
   "hi": "ज्ञानविज्ञानयोग",
   "about": "Krishna describes his higher and lower natures and the four kinds of people who turn to God."
  },
  {
   "n": 8,
   "sa": "अक्षरब्रह्मयोगः",
   "en": "The Imperishable Brahman",
   "hi": "अक्षरब्रह्मयोग",
   "about": "What we remember at the time of death, and the paths that lead to return or to liberation."
  },
  {
   "n": 9,
   "sa": "राजविद्याराजगुह्ययोगः",
   "en": "The Royal Knowledge and Secret",
   "hi": "राजविद्याराजगुह्ययोग",
   "about": "The supreme secret of devotion: God accepts even a leaf, a flower, a fruit or water offered with love."
  },
  {
   "n": 10,
   "sa": "विभूतियोगः",
   "en": "Divine Glories",
   "hi": "विभूतियोग",
   "about": "Krishna names his glories in the world — wherever there is excellence, it springs from a spark of his splendour."
  },
  {
   "n": 11,
   "sa": "विश्वरूपदर्शनयोगः",
   "en": "The Vision of the Cosmic Form",
   "hi": "विश्वरूपदर्शनयोग",
   "about": "Arjuna is granted divine sight and beholds Krishna's universal form."
  },
  {
   "n": 12,
   "sa": "भक्तियोगः",
   "en": "The Yoga of Devotion",
   "hi": "भक्तियोग",
   "about": "The path of devotion and the qualities of the devotee who is dear to God."
  },
  {
   "n": 13,
   "sa": "क्षेत्रक्षेत्रज्ञविभागयोगः",
   "en": "The Field and its Knower",
   "hi": "क्षेत्रक्षेत्रज्ञविभागयोग",
   "about": "The body as the field, the self as the knower of the field, and the qualities that make up true knowledge."
  },
  {
   "n": 14,
   "sa": "गुणत्रयविभागयोगः",
   "en": "The Three Gunas",
   "hi": "गुणत्रयविभागयोग",
   "about": "Sattva, rajas and tamas — the three qualities that bind us — and how to rise above them."
  },
  {
   "n": 15,
   "sa": "पुरुषोत्तमयोगः",
   "en": "The Supreme Person",
   "hi": "पुरुषोत्तमयोग",
   "about": "The upside-down ashvattha tree of worldly life, and the Supreme Person beyond the perishable and the imperishable."
  },
  {
   "n": 16,
   "sa": "दैवासुरसम्पद्विभागयोगः",
   "en": "Divine and Demonic Natures",
   "hi": "दैवासुरसम्पद्विभागयोग",
   "about": "The qualities that lead to freedom and those that lead to bondage; desire, anger and greed as the three gates to ruin."
  },
  {
   "n": 17,
   "sa": "श्रद्धात्रयविभागयोगः",
   "en": "The Three Kinds of Faith",
   "hi": "श्रद्धात्रयविभागयोग",
   "about": "Faith, food, sacrifice, austerity and charity, each seen in its sattvic, rajasic and tamasic forms."
  },
  {
   "n": 18,
   "sa": "मोक्षसंन्यासयोगः",
   "en": "Liberation through Renunciation",
   "hi": "मोक्षसंन्यासयोग",
   "about": "A summary of the whole teaching, ending in surrender to God; Arjuna's doubts are dispelled."
  }
 ],
